<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/smartvideo/db" VERSION="20261105" COMMENT="XMLDB file for mod_smartvideo"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="smartvideo" COMMENT="Defines instances of the Smart Video course activity">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Course ID"/>
        <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Activity name"/>
        <FIELD NAME="intro" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Activity introduction/description"/>
        <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Format of intro"/>
        <FIELD NAME="mediaid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="FK referencing local_securevideolibrary_media.id"/>
        <FIELD NAME="watermarkenabled" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="1 if dynamic watermark is enabled, 0 otherwise"/>
        <FIELD NAME="watermarkopacity" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="35" SEQUENCE="false" COMMENT="Watermark opacity percent (10-100)"/>
        <FIELD NAME="preventseeking" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="1 if forward seeking is locked past max watched position"/>
        <FIELD NAME="completionminpercent" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Minimum watch percentage required for completion"/>
        <FIELD NAME="completionrequirequestions" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="1 if student must pass all interactive questions for completion"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="course_idx" UNIQUE="false" FIELDS="course"/>
        <INDEX NAME="mediaid_idx" UNIQUE="false" FIELDS="mediaid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="smartvideo_progress" COMMENT="Stores student watch progress, bookmarks and merged intervals">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="instanceid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="FK to smartvideo.id"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="User ID"/>
        <FIELD NAME="lastposition" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Last playback position in seconds"/>
        <FIELD NAME="maxposition" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Furthest watched position in seconds for anti-seeking"/>
        <FIELD NAME="watchedseconds" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Total unique seconds watched"/>
        <FIELD NAME="watchedintervals" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="JSON encoded array of watched intervals"/>
        <FIELD NAME="percentcompleted" TYPE="int" LENGTH="3" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Calculated percentage watched (0-100)"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="instanceid_fk" TYPE="foreign" FIELDS="instanceid" REFTABLE="smartvideo" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="instanceid_userid_idx" UNIQUE="true" FIELDS="instanceid, userid"/>
        <INDEX NAME="userid_idx" UNIQUE="false" FIELDS="userid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="smartvideo_questions" COMMENT="Interactive question cuepoints configured on video timeline">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="instanceid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="FK to smartvideo.id"/>
        <FIELD NAME="questionbankentryid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="FK to question_bank_entries.id"/>
        <FIELD NAME="questionid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="FK to question.id"/>
        <FIELD NAME="timecode" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Playback timestamp in seconds where video pauses"/>
        <FIELD NAME="title" TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false" COMMENT="Optional title or label for the cuepoint"/>
        <FIELD NAME="requirecorrect" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="1 if student must pass to resume video, 0 if informational"/>
        <FIELD NAME="rewindonfail" TYPE="int" LENGTH="5" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Seconds to rewind on failure, 0 for retry on spot"/>
        <FIELD NAME="rewindto" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="-1" SEQUENCE="false" COMMENT="Target timestamp to rewind to on failure, -1 for retry in place"/>
        <FIELD NAME="questionstyle" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="compact" SEQUENCE="false" COMMENT="Display style: compact or native"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="instanceid_fk" TYPE="foreign" FIELDS="instanceid" REFTABLE="smartvideo" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="instanceid_timecode_idx" UNIQUE="false" FIELDS="instanceid, timecode"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="smartvideo_qattempts" COMMENT="Tracks student attempts and pass status for in-video questions">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="instanceid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="FK to smartvideo.id"/>
        <FIELD NAME="svquestionid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="FK to smartvideo_questions.id"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="User ID"/>
        <FIELD NAME="qubaid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="FK to question_usages.id"/>
        <FIELD NAME="slot" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="1" SEQUENCE="false" COMMENT="Slot number in quba"/>
        <FIELD NAME="passed" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="1 if question answered correctly, 0 otherwise"/>
        <FIELD NAME="attempts" TYPE="int" LENGTH="5" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Number of attempts taken"/>
        <FIELD NAME="fraction" TYPE="number" LENGTH="12" NOTNULL="false" SEQUENCE="false" DECIMALS="7" COMMENT="Score fraction from question engine"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="instanceid_fk" TYPE="foreign" FIELDS="instanceid" REFTABLE="smartvideo" REFFIELDS="id"/>
        <KEY NAME="svquestionid_fk" TYPE="foreign" FIELDS="svquestionid" REFTABLE="smartvideo_questions" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="svquestionid_userid_idx" UNIQUE="true" FIELDS="svquestionid, userid"/>
        <INDEX NAME="instanceid_userid_idx" UNIQUE="false" FIELDS="instanceid, userid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="smartvideo_chapters" COMMENT="Video chapter markers and table of contents">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="instanceid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="FK to smartvideo.id"/>
        <FIELD NAME="timecode" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Start time in seconds"/>
        <FIELD NAME="title" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Chapter title"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="instanceid_fk" TYPE="foreign" FIELDS="instanceid" REFTABLE="smartvideo" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="instanceid_timecode_idx" UNIQUE="false" FIELDS="instanceid, timecode"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="smartvideo_callouts" COMMENT="In-video callout cards, formulas and resource link overlays">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="instanceid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="FK to smartvideo.id"/>
        <FIELD NAME="timecode" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Trigger time in seconds"/>
        <FIELD NAME="duration" TYPE="int" LENGTH="5" NOTNULL="true" DEFAULT="8" SEQUENCE="false" COMMENT="Duration in seconds if not autopause"/>
        <FIELD NAME="title" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Callout title"/>
        <FIELD NAME="body" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Callout content/markdown"/>
        <FIELD NAME="linkurl" TYPE="char" LENGTH="512" NOTNULL="false" SEQUENCE="false" COMMENT="Optional resource or Moodle link"/>
        <FIELD NAME="linklabel" TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false" COMMENT="Label for the link button"/>
        <FIELD NAME="autopause" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="1 if video auto-pauses on appearance"/>
        <FIELD NAME="position" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="bottom-right" SEQUENCE="false" COMMENT="Position: bottom-right, top-right, bottom-left, top-left"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="instanceid_fk" TYPE="foreign" FIELDS="instanceid" REFTABLE="smartvideo" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="instanceid_timecode_idx" UNIQUE="false" FIELDS="instanceid, timecode"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="smartvideo_notes" COMMENT="Student timestamped notes in the Workstation Sidebar">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="instanceid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="FK to smartvideo.id"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="User ID"/>
        <FIELD NAME="timecode" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Timestamp in seconds"/>
        <FIELD NAME="content" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="Note text content"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="instanceid_fk" TYPE="foreign" FIELDS="instanceid" REFTABLE="smartvideo" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="instanceid_userid_idx" UNIQUE="false" FIELDS="instanceid, userid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="smartvideo_reports" COMMENT="Structured student clinical and case inspection reports">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="instanceid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="FK to smartvideo.id"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="User ID"/>
        <FIELD NAME="findings" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Clinical or observational findings"/>
        <FIELD NAME="impression" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Clinical impression or summary"/>
        <FIELD NAME="diagnosis" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Differential diagnosis or conclusions"/>
        <FIELD NAME="recommendations" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Treatment or next steps recommendations"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="draft" SEQUENCE="false" COMMENT="draft or submitted"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="instanceid_fk" TYPE="foreign" FIELDS="instanceid" REFTABLE="smartvideo" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="instanceid_userid_idx" UNIQUE="true" FIELDS="instanceid, userid"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="smartvideo_subtitles" COMMENT="WebVTT closed captions and transcripts for video playback">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="instanceid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="FK to smartvideo.id"/>
        <FIELD NAME="lang" TYPE="char" LENGTH="10" NOTNULL="true" DEFAULT="en" SEQUENCE="false" COMMENT="Language code, e.g. en, ar"/>
        <FIELD NAME="label" TYPE="char" LENGTH="100" NOTNULL="true" DEFAULT="English" SEQUENCE="false" COMMENT="Display label for subtitle menu"/>
        <FIELD NAME="content" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="Raw WebVTT file content"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="instanceid_fk" TYPE="foreign" FIELDS="instanceid" REFTABLE="smartvideo" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="instanceid_lang_idx" UNIQUE="true" FIELDS="instanceid, lang"/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="smartvideo_discussions" COMMENT="Timestamped student and instructor Q&amp;A discussions">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="instanceid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="FK to smartvideo.id"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="User ID who posted"/>
        <FIELD NAME="timecode" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Video timestamp in seconds or 0"/>
        <FIELD NAME="content" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="Discussion comment text"/>
        <FIELD NAME="parentid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Parent discussion ID for threaded replies"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
        <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="instanceid_fk" TYPE="foreign" FIELDS="instanceid" REFTABLE="smartvideo" REFFIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="instanceid_timecode_idx" UNIQUE="false" FIELDS="instanceid, timecode"/>
        <INDEX NAME="parentid_idx" UNIQUE="false" FIELDS="parentid"/>
      </INDEXES>
    </TABLE>
  </TABLES>
</XMLDB>
