{{!
    @template mod_smartvideo/picker_modal

    Modal for selecting videos from the central video library.
}}
<div class="modal fade smartvideo-picker-modal securevideo-picker-modal" id="smartVideoPickerModal" tabindex="-1" aria-labelledby="smartVideoPickerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="smartVideoPickerModalLabel">
                    <i class="fa fa-film me-2" aria-hidden="true"></i>{{#str}}selectfromlibrary, mod_smartvideo{{/str}}
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" data-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                {{! Toolbar: Scope tabs, Search, Upload new, Refresh }}
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 pb-3 border-bottom">
                    <ul class="nav nav-pills smartvideo-picker-tabs securevideo-picker-tabs">
                        <li class="nav-item">
                            <button type="button" class="nav-link active" data-scope="my">
                                {{#str}}scope_my, mod_smartvideo{{/str}}
                            </button>
                        </li>
                        {{#hascourse}}
                        <li class="nav-item">
                            <button type="button" class="nav-link" data-scope="course">
                                {{#str}}scope_course, mod_smartvideo{{/str}}
                            </button>
                        </li>
                        {{/hascourse}}
                        <li class="nav-item">
                            <button type="button" class="nav-link" data-scope="all">
                                {{#str}}scope_all, mod_smartvideo{{/str}}
                            </button>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-2">
                        <div class="input-group">
                            <span class="input-group-text"><i class="fa fa-search" aria-hidden="true"></i></span>
                            <input type="text" class="form-control smartvideo-picker-search securevideo-picker-search" placeholder="{{#str}}searchvideos, mod_smartvideo{{/str}}">
                        </div>

                        <button type="button" class="btn btn-outline-secondary smartvideo-picker-refresh securevideo-picker-refresh" title="{{#str}}refreshlist, mod_smartvideo{{/str}}">
                            <i class="fa fa-refresh" aria-hidden="true"></i>
                        </button>

                        <a href="{{uploadurl}}" target="_blank" class="btn btn-outline-primary" rel="noopener noreferrer">
                            <i class="fa fa-cloud-upload me-1" aria-hidden="true"></i>{{#str}}uploadnewvideo, mod_smartvideo{{/str}}
                        </a>
                    </div>
                </div>

                {{! Loading Spinner }}
                <div class="smartvideo-picker-loading securevideo-picker-loading text-center py-5 d-none">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">{{#str}}loadingvideos, mod_smartvideo{{/str}}</span>
                    </div>
                    <p class="mt-2 text-muted">{{#str}}loadingvideos, mod_smartvideo{{/str}}</p>
                </div>

                {{! Video Cards Grid }}
                <div class="row row-cols-1 row-cols-md-3 g-3 smartvideo-picker-grid securevideo-picker-grid">
                </div>

                {{! Empty State }}
                <div class="smartvideo-picker-empty securevideo-picker-empty text-center py-5 d-none">
                    <i class="fa fa-video-camera fa-3x text-muted mb-2" aria-hidden="true"></i>
                    <p class="text-muted mb-0">{{#str}}novideoselected, mod_smartvideo{{/str}}</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" data-dismiss="modal">
                    {{#str}}closebuttontitle, core{{/str}}
                </button>
            </div>
        </div>
    </div>
</div>
