{{!
    @template mod_smartvideo/player

    Encrypted HLS video player with dynamic canvas watermark, interactive questions,
    YouTube-style chapters, in-video callout cards, and pluggable 3-zone workstation sidebar.
}}
<div class="mod-smartvideo-wrapper mod-securevideo-wrapper my-3">
    <div id="smartVideoContainer"
         class="smartvideo-player-container securevideo-player-container position-relative bg-black rounded shadow-lg overflow-hidden is-paused"
         tabindex="0"
         data-cmid="{{cmid}}"
         data-videotype="{{videotype}}"
         data-videourl="{{videourl}}"
         data-playlisturl="{{playlisturl}}"
         data-duration="{{duration}}"
         data-lastposition="{{lastposition}}"
         data-maxposition="{{maxposition}}"
         data-watchedseconds="{{watchedseconds}}"
         data-watchedintervals="{{{watchedintervals}}}"
         data-percentcompleted="{{percentcompleted}}"
         data-completionminpercent="{{completionminpercent}}"
         data-preventseeking="{{#preventseeking}}1{{/preventseeking}}{{^preventseeking}}0{{/preventseeking}}"
         data-watermarkenabled="{{#watermarkenabled}}1{{/watermarkenabled}}{{^watermarkenabled}}0{{/watermarkenabled}}"
         data-watermarkopacity="{{watermarkopacity}}"
         data-studentname="{{studentname}}"
         data-studentid="{{studentid}}"
         data-studentip="{{studentip}}"
         data-livetime="{{livetime}}"
         data-questions="{{{questionsjson}}}"
         data-chapters="{{{chaptersjson}}}"
         data-callouts="{{{calloutsjson}}}"
         data-cues="{{{cuesjson}}}"
         data-tracks="{{{tracksjson}}}">

        {{! Workstation Body: Flex row containing Stage (Zone 1) + Sidebar (Zone 2) }}
        <div class="smartvideo-workstation-body d-flex flex-row position-relative w-100 h-100 overflow-hidden">

            {{! ZONE 1: Video Stage (16:9 in normal view, full fill in fullscreen) }}
            <div class="smartvideo-stage position-relative flex-grow-1 overflow-hidden user-select-none">
                <div class="smartvideo-stage-ratio ratio ratio-16x9 position-relative bg-black">
                    {{! External Provider Iframe Mount Container }}
                    <div id="smartVideoExternalMount" class="position-absolute top-0 start-0 w-100 h-100 overflow-hidden d-none" style="z-index: 1;"></div>

                    {{! Video Click Shield: captures single-click play/pause and double-click fullscreen }}
                    <div id="smartVideoClickShield" class="smartvideo-click-shield position-absolute top-0 start-0 w-100 h-100" style="z-index: 6; pointer-events: auto;"></div>

                    <video id="smartVideoElement"
                           class="w-100 h-100 position-relative"
                           style="z-index: 2;"
                           playsinline
                           preload="auto"
                           poster="{{thumbnailurl}}"
                           controlslist="nodownload noplaybackrate"
                           disablepictureinpicture="true"
                           oncontextmenu="return false;">
                    </video>

                    {{! Dynamic moving canvas watermark overlay - floats over video & question overlay }}
                    {{#watermarkenabled}}
                    <canvas id="smartVideoWatermarkCanvas"
                            class="smartvideo-watermark-canvas securevideo-watermark-canvas position-absolute top-0 start-0 w-100 h-100"
                            style="pointer-events: none; z-index: 50;">
                    </canvas>
                    {{/watermarkenabled}}

                    {{! Center big play/pause button overlay }}
                    <div class="smartvideo-center-overlay securevideo-center-overlay position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center cursor-pointer"
                         style="z-index: 10;">
                        <button type="button" class="btn btn-dark bg-opacity-50 text-white rounded-circle p-3 smartvideo-btn-bigplay securevideo-btn-bigplay" aria-label="{{#str}}play, mod_smartvideo{{/str}}">
                            <i class="fa fa-play fa-2x" aria-hidden="true"></i>
                        </button>
                    </div>

                    {{! Resume Playback Toast }}
                    {{#hasresume}}
                    <div id="smartVideoResumeToast"
                         class="smartvideo-resume-toast securevideo-resume-toast position-absolute top-0 start-50 translate-middle-x mt-3 bg-dark bg-opacity-90 text-white px-3 py-2 rounded shadow d-flex align-items-center gap-2 border border-secondary"
                         style="z-index: 25;">
                        <i class="fa fa-history text-info" aria-hidden="true"></i>
                        <span class="small">{{#str}}resumeprompt, mod_smartvideo, {{lastposformatted}}{{/str}}</span>
                        <button type="button" class="btn btn-sm btn-primary py-0 px-2 btn-action-resume">{{#str}}resume, mod_smartvideo{{/str}}</button>
                        <button type="button" class="btn btn-sm btn-outline-light py-0 px-2 btn-action-dismiss">{{#str}}startover, mod_smartvideo{{/str}}</button>
                    </div>
                    {{/hasresume}}

                    {{! Seeking locked notification }}
                    <div id="smartVideoSeekNotice"
                         class="smartvideo-seek-notice securevideo-seek-notice position-absolute top-50 start-50 translate-middle bg-dark bg-opacity-90 text-white px-3 py-2 rounded shadow d-none"
                         style="z-index: 20;">
                        <i class="fa fa-lock text-warning me-1" aria-hidden="true"></i>
                        <span>{{#str}}seekinglocked, mod_smartvideo{{/str}}</span>
                    </div>

                    {{! Interactive Question Overlay - inside player container for seamless fullscreen }}
                    <div id="smartVideoQuestionOverlay"
                         class="smartvideo-question-overlay securevideo-question-overlay d-none">
                        <div class="sv-qmodal">
                            <div class="sv-qmodal-header">
                                <span class="sv-qmodal-title smartvideo-q-title securevideo-q-title">
                                    <i class="fa fa-circle-question me-2" aria-hidden="true"></i>{{#str}}knowledgecheck, mod_smartvideo{{/str}}
                                </span>
                                <div class="d-flex align-items-center gap-2">
                                    <button type="button" class="btn btn-sm btn-outline-light py-0 px-2 smartvideo-btn-toggle-style securevideo-btn-toggle-style" title="{{#str}}togglestyle, mod_smartvideo{{/str}}">
                                        <i class="fa fa-sliders me-1" aria-hidden="true"></i><span class="sv-current-style-label">Compact</span>
                                    </button>
                                    <span class="sv-qmodal-badge smartvideo-q-timecode securevideo-q-timecode">00:00</span>
                                </div>
                            </div>
                            <div class="sv-qmodal-body smartvideo-q-body securevideo-q-body">
                                <div class="smartvideo-q-loading securevideo-q-loading text-center py-4">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">Loading question...</span>
                                    </div>
                                </div>
                                <div class="smartvideo-q-content securevideo-q-content d-none">
                                    {{! Injected Question Engine HTML }}
                                </div>
                                <div class="smartvideo-q-feedback securevideo-q-feedback d-none mt-2">
                                    {{! Injected Graded Feedback HTML }}
                                </div>
                            </div>
                            <div class="sv-qmodal-footer">
                                <button type="button" class="btn btn-outline-secondary btn-sm smartvideo-btn-retry securevideo-btn-retry d-none">
                                    <i class="fa fa-rotate-left me-1" aria-hidden="true"></i>{{#str}}tryagain, mod_smartvideo{{/str}}
                                </button>
                                <button type="button" class="btn btn-primary btn-sm ms-auto smartvideo-btn-submit securevideo-btn-submit">
                                    <i class="fa fa-check me-1" aria-hidden="true"></i>{{#str}}submitanswer, mod_smartvideo{{/str}}
                                </button>
                                <button type="button" class="btn btn-success btn-sm ms-auto smartvideo-btn-continue securevideo-btn-continue d-none">
                                    <i class="fa fa-arrow-right me-1" aria-hidden="true"></i>{{#str}}continuevideo, mod_smartvideo{{/str}}
                                </button>
                            </div>
                        </div>
                    </div>

                    {{! In-Video Non-Intrusive Callout Card Overlay }}
                    <div id="smartVideoCalloutOverlay"
                         class="smartvideo-callout-overlay position-absolute p-3 d-none"
                         style="z-index: 22; pointer-events: none;">
                        <div class="card bg-dark bg-opacity-95 text-white border-secondary shadow-lg smartvideo-callout-card"
                             style="max-width: 380px; pointer-events: auto;">
                            <div class="card-header bg-transparent border-secondary py-2 d-flex justify-content-between align-items-center">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="fa fa-info-circle text-info" aria-hidden="true"></i>
                                    <span class="fw-semibold small smartvideo-callout-title">Callout</span>
                                </div>
                                <button type="button" class="btn-close btn-close-white btn-sm smartvideo-btn-callout-close" aria-label="Close"></button>
                            </div>
                            <div class="card-body py-2 px-3 small smartvideo-callout-body">
                                {{! Dynamic Callout Text/HTML }}
                            </div>
                            <div class="card-footer bg-transparent border-0 pt-0 pb-2 smartvideo-callout-footer d-flex gap-2">
                                <a href="#" target="_blank" class="btn btn-sm btn-primary py-0 px-2 smartvideo-callout-link d-none">
                                    <i class="fa fa-external-link me-1" aria-hidden="true"></i><span class="smartvideo-callout-link-label">Open</span>
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-light py-0 px-2 ms-auto smartvideo-btn-callout-continue d-none">
                                    {{#str}}continuevideo, mod_smartvideo{{/str}}
                                </button>
                            </div>
                        </div>
                    </div>

                    {{! In-Video Dynamic Captions Overlay }}
                    <div id="smartVideoCaptionsOverlay"
                         class="smartvideo-captions-overlay position-absolute start-50 translate-middle-x px-3 py-1 rounded d-none"
                         style="bottom: 12%; z-index: 21; pointer-events: none; max-width: 82%;">
                        <span class="smartvideo-caption-text fw-semibold"></span>
                    </div>
                </div>

                {{! Custom Controls Bar }}
                <div class="smartvideo-controls-bar securevideo-controls-bar bg-dark bg-opacity-95 text-white p-2" style="z-index: 45;">
                    {{! Scrubber / Timeline Track with YouTube-Style Segmented Chapters }}
                    <div class="smartvideo-timeline-wrapper securevideo-timeline-wrapper position-relative py-1 cursor-pointer">
                        {{! YouTube-Style Floating Preview Tooltip }}
                        <div id="smartVideoHoverTooltip"
                             class="smartvideo-hover-tooltip position-absolute d-none text-center"
                             style="bottom: calc(100% + 8px); transform: translateX(-50%); z-index: 30; pointer-events: none;">
                            <div class="smartvideo-hover-chapter-name fw-semibold small text-truncate d-none"></div>
                            <div class="smartvideo-hover-time font-monospace small">00:00</div>
                        </div>

                        <div class="smartvideo-timeline-track securevideo-timeline-track position-relative">
                            {{! Flex container for segmented chapters }}
                            <div class="smartvideo-segments-container position-absolute top-0 start-0 w-100 h-100 d-flex" style="z-index: 1;">
                                {{! Default continuous segment }}
                                <div class="smartvideo-segment" style="flex: 1 1 0%;">
                                    <div class="smartvideo-segment-bg"></div>
                                    <div class="smartvideo-segment-buffered" style="width: 0%;"></div>
                                    <div class="smartvideo-segment-progress" style="width: 0%;"></div>
                                </div>
                            </div>

                            {{! YouTube-Style Scrubber Thumb / Knob }}
                            <div class="smartvideo-scrubber-thumb position-absolute top-50 rounded-circle" style="left: 0%; transform: translate(-50%, -50%); z-index: 5;"></div>

                            {{! Overlays for markers and anti-seeking }}
                            <div class="smartvideo-cues-overlay position-absolute top-0 start-0 w-100 h-100" style="pointer-events: none; z-index: 6;">
                                {{#preventseeking}}
                                <div class="smartvideo-max-marker securevideo-max-marker position-absolute top-0 h-100 bg-warning" style="width: 3px; left: 0%;" title="{{#str}}preventseeking, mod_smartvideo{{/str}}"></div>
                                {{/preventseeking}}

                                {{! Interactive question cue markers on timeline }}
                                {{#questions}}
                                <div class="smartvideo-cue-marker securevideo-cue-marker position-absolute top-50 rounded-circle border border-white {{#passed}}bg-success{{/passed}}{{^passed}}bg-info{{/passed}}"
                                     data-cueid="{{id}}"
                                     data-timecode="{{timecode}}"
                                     style="left: {{percent}}%; width: 10px; height: 10px; transform: translate(-50%, -50%);"
                                     title="{{title}} ({{timeformatted}})"></div>
                                {{/questions}}

                                {{! In-Video Callout cue markers on timeline }}
                                {{#callouts}}
                                <div class="smartvideo-callout-marker position-absolute top-50 rounded-circle border border-dark bg-warning"
                                     data-calloutid="{{id}}"
                                     data-timecode="{{timecode}}"
                                     style="left: {{percent}}%; width: 8px; height: 8px; transform: translate(-50%, -50%);"
                                     title="{{title}} ({{timeformatted}})"></div>
                                {{/callouts}}
                            </div>
                        </div>
                    </div>

                    {{! Button Row }}
                    <div class="d-flex justify-content-between align-items-center mt-1">
                        {{! Left: Play, Volume, Time, Chapter Pill }}
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-link text-white p-1 smartvideo-btn-play securevideo-btn-play" title="{{#str}}play, mod_smartvideo{{/str}}">
                                <i class="fa fa-play" aria-hidden="true"></i>
                            </button>
                            <div class="d-flex align-items-center gap-1 smartvideo-volume-group securevideo-volume-group">
                                <button type="button" class="btn btn-link text-white p-1 smartvideo-btn-mute securevideo-btn-mute" title="{{#str}}mute, mod_smartvideo{{/str}}">
                                    <i class="fa fa-volume-up" aria-hidden="true"></i>
                                </button>
                                <input type="range" class="form-range smartvideo-volume-slider securevideo-volume-slider" min="0" max="1" step="0.05" value="1" style="width: 70px;">
                            </div>
                            <span class="small font-monospace text-white-50 ms-1 d-flex align-items-center gap-1">
                                <span class="smartvideo-current-time securevideo-current-time text-white">00:00</span> / {{durationformatted}}
                            </span>

                            {{! YouTube-Style Inline Chapter Label }}
                            <div class="smartvideo-chapter-inline-wrap {{^haschapters}}d-none{{/haschapters}} d-none d-sm-inline-flex align-items-center ms-2 text-white-50">
                                <span class="smartvideo-chapter-inline-dot me-2 text-white-50">•</span>
                                <button type="button"
                                        class="btn btn-link p-0 text-white text-decoration-none smartvideo-chapter-inline-btn smartvideo-chapter-pill d-inline-flex align-items-center"
                                        title="{{#str}}chapters, mod_smartvideo{{/str}}">
                                    <span class="smartvideo-chapter-inline-title smartvideo-chapter-pill-label text-truncate fw-normal" style="max-width: 200px;">{{#str}}chapters, mod_smartvideo{{/str}}</span>
                                    <i class="fa fa-chevron-right fa-xs smartvideo-chapter-chevron ms-1 text-white-50" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>

                        {{! Right: Speed, Quality, Sidebar Tools Toggle, Fullscreen }}
                        <div class="d-flex align-items-center gap-2">
                            {{! Playback Speed Dropup }}
                            <div class="dropup position-relative">
                                <button class="btn btn-sm btn-link text-white text-decoration-none p-1 dropdown-toggle smartvideo-btn-speed securevideo-btn-speed"
                                        type="button"
                                        aria-expanded="false"
                                        title="{{#str}}speed, mod_smartvideo{{/str}}">
                                    <span class="smartvideo-current-speed securevideo-current-speed">1x</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-dark smartvideo-speed-menu securevideo-speed-menu">
                                    <li><button class="dropdown-item" type="button" data-speed="0.75">0.75x</button></li>
                                    <li><button class="dropdown-item active" type="button" data-speed="1.0">1x (Normal)</button></li>
                                    <li><button class="dropdown-item" type="button" data-speed="1.25">1.25x</button></li>
                                    <li><button class="dropdown-item" type="button" data-speed="1.5">1.5x</button></li>
                                    <li><button class="dropdown-item" type="button" data-speed="2.0">2x</button></li>
                                </ul>
                            </div>

                            {{! Quality Dropup }}
                            <div class="dropup position-relative smartvideo-quality-container securevideo-quality-container d-none">
                                <button class="btn btn-sm btn-link text-white text-decoration-none p-1 dropdown-toggle smartvideo-btn-quality securevideo-btn-quality"
                                        type="button"
                                        aria-expanded="false"
                                        title="{{#str}}quality, mod_smartvideo{{/str}}">
                                    <i class="fa fa-cog me-1" aria-hidden="true"></i><span class="smartvideo-current-quality securevideo-current-quality">{{#str}}auto, mod_smartvideo{{/str}}</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-dark smartvideo-quality-menu securevideo-quality-menu">
                                    <li><button class="dropdown-item active" type="button" data-level="-1">{{#str}}auto, mod_smartvideo{{/str}}</button></li>
                                </ul>
                            </div>

                            {{! Closed Captions / Subtitles Dropup }}
                            {{#hassubtitles}}
                            <div class="dropup position-relative smartvideo-captions-container">
                                <button class="btn btn-sm btn-link text-white text-decoration-none p-1 dropdown-toggle smartvideo-btn-cc"
                                        type="button"
                                        aria-expanded="false"
                                        title="{{#str}}captions, mod_smartvideo{{/str}}">
                                    <i class="fa fa-cc me-1" aria-hidden="true"></i><span class="smartvideo-current-cc font-monospace">Off</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-dark smartvideo-cc-menu">
                                    <li><button class="dropdown-item active" type="button" data-trackid="-1">{{#str}}captions_off, mod_smartvideo{{/str}}</button></li>
                                    {{#subtitles}}
                                    <li><button class="dropdown-item" type="button" data-trackid="{{id}}" data-lang="{{lang}}">{{label}}</button></li>
                                    {{/subtitles}}
                                </ul>
                            </div>
                            {{/hassubtitles}}

                            {{! Workstation Sidebar Toggle Button }}
                            <button type="button"
                                    class="btn btn-link text-white p-1 smartvideo-btn-sidebar"
                                    title="{{#str}}sidebar_toggle, mod_smartvideo{{/str}}">
                                <i class="fa fa-columns" aria-hidden="true"></i>
                            </button>

                            {{! Fullscreen Toggle }}
                            <button type="button" class="btn btn-link text-white p-1 smartvideo-btn-fullscreen securevideo-btn-fullscreen" title="{{#str}}fullscreen, mod_smartvideo{{/str}}">
                                <i class="fa fa-expand" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            {{! ZONE 2: Workstation Sidebar (Collapsible, Resizable Split-View on >=960px & Fullscreen, Overlay on Mobile) }}
            <aside class="smartvideo-sidebar d-flex flex-column bg-dark text-white user-select-text d-none position-relative"
                   aria-label="{{#str}}workstation_tools, mod_smartvideo{{/str}}">
                {{! Draggable Resize Handle on leading edge }}
                <div class="smartvideo-sidebar-resizer" role="separator" aria-orientation="vertical" title="{{#str}}resize_sidebar, mod_smartvideo{{/str}}">
                    <div class="smartvideo-sidebar-resizer-line"></div>
                </div>

                {{! Sidebar Header with Icon Tabs & Mode Controls }}
                <div class="smartvideo-sidebar-header p-2 border-bottom border-secondary border-opacity-25 bg-black bg-opacity-40">
                    {{! Top Utility Row: Active Tab Title + Mode Toggle & Close buttons }}
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="small fw-semibold text-white-50 text-uppercase smartvideo-sidebar-active-tab-title text-truncate" style="font-size: 0.72rem; letter-spacing: 0.5px; max-width: 220px;">
                            {{#str}}chapters, mod_smartvideo{{/str}}
                        </span>
                        <div class="d-flex align-items-center gap-1 flex-shrink-0">
                            {{! Split View vs Overlay mode toggle button }}
                            <button type="button" class="btn btn-sm btn-link text-white p-0 px-1 smartvideo-btn-sidebar-mode" title="{{#str}}sidebar_split_mode, mod_smartvideo{{/str}}">
                                <i class="fa fa-table-columns" aria-hidden="true"></i>
                            </button>
                            {{! Close button }}
                            <button type="button" class="btn btn-sm btn-link text-white p-0 px-1 smartvideo-btn-sidebar-close" title="{{#str}}close_sidebar, mod_smartvideo{{/str}}">
                                <i class="fa fa-times" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>

                    {{! Tabs container with compact icon-only buttons for all workstation tools }}
                    <ul class="nav nav-pills smartvideo-sidebar-tabs d-flex flex-wrap gap-1 align-items-center m-0" role="tablist">
                        {{! 1. Chapters: Icon }}
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active py-1 px-2 btn-sm text-white smartvideo-tab-icon-only"
                                    id="tabBtnChapters"
                                    data-bs-toggle="pill"
                                    data-bs-target="#panelChapters"
                                    type="button"
                                    role="tab"
                                    aria-selected="true"
                                    title="{{#str}}chapters, mod_smartvideo{{/str}}">
                                <i class="fa fa-list-ol" aria-hidden="true"></i>
                            </button>
                        </li>
                        {{! 2. Transcript: Icon }}
                        <li class="nav-item" role="presentation">
                            <button class="nav-link py-1 px-2 btn-sm text-white smartvideo-tab-icon-only"
                                    id="tabBtnTranscript"
                                    data-bs-toggle="pill"
                                    data-bs-target="#panelTranscript"
                                    type="button"
                                    role="tab"
                                    aria-selected="false"
                                    title="{{#str}}transcript, mod_smartvideo{{/str}}">
                                <i class="fa fa-align-left" aria-hidden="true"></i>
                            </button>
                        </li>
                        {{! 3. Notes: Icon + Badge }}
                        <li class="nav-item" role="presentation">
                            <button class="nav-link py-1 px-2 btn-sm text-white smartvideo-tab-icon-only d-inline-flex align-items-center"
                                    id="tabBtnNotes"
                                    data-bs-toggle="pill"
                                    data-bs-target="#panelNotes"
                                    type="button"
                                    role="tab"
                                    aria-selected="false"
                                    title="{{#str}}notes, mod_smartvideo{{/str}}">
                                <i class="fa fa-pencil" aria-hidden="true"></i>
                                <span class="badge bg-secondary smartvideo-notes-count-badge rounded-pill ms-1" style="font-size: 0.65rem;">{{notecount}}</span>
                            </button>
                        </li>
                        {{! 4. Discussions / Q&A: Icon + Badge }}
                        <li class="nav-item" role="presentation">
                            <button class="nav-link py-1 px-2 btn-sm text-white smartvideo-tab-icon-only d-inline-flex align-items-center"
                                    id="tabBtnQA"
                                    data-bs-toggle="pill"
                                    data-bs-target="#panelQA"
                                    type="button"
                                    role="tab"
                                    aria-selected="false"
                                    title="{{#str}}discussions, mod_smartvideo{{/str}}">
                                <i class="fa fa-comments" aria-hidden="true"></i>
                                <span class="badge bg-secondary smartvideo-qa-count-badge rounded-pill ms-1" style="font-size: 0.65rem;">{{discussioncount}}</span>
                            </button>
                        </li>
                        {{! 5. Calculator: Icon }}
                        <li class="nav-item" role="presentation">
                            <button class="nav-link py-1 px-2 btn-sm text-white smartvideo-tab-icon-only"
                                    id="tabBtnCalc"
                                    data-bs-toggle="pill"
                                    data-bs-target="#panelCalc"
                                    type="button"
                                    role="tab"
                                    aria-selected="false"
                                    title="{{#str}}calculator, mod_smartvideo{{/str}}">
                                <i class="fa fa-calculator" aria-hidden="true"></i>
                            </button>
                        </li>
                        {{! 6. Medical / Case Report: Icon }}
                        <li class="nav-item" role="presentation">
                            <button class="nav-link py-1 px-2 btn-sm text-white smartvideo-tab-icon-only"
                                    id="tabBtnReport"
                                    data-bs-toggle="pill"
                                    data-bs-target="#panelReport"
                                    type="button"
                                    role="tab"
                                    aria-selected="false"
                                    title="{{#str}}medicalreport, mod_smartvideo{{/str}}">
                                <i class="fa fa-stethoscope" aria-hidden="true"></i>
                            </button>
                        </li>
                        {{! 7. Handouts & Resources: Icon + Badge }}
                        <li class="nav-item" role="presentation">
                            <button class="nav-link py-1 px-2 btn-sm text-white smartvideo-tab-icon-only d-inline-flex align-items-center"
                                    id="tabBtnResources"
                                    data-bs-toggle="pill"
                                    data-bs-target="#panelResources"
                                    type="button"
                                    role="tab"
                                    aria-selected="false"
                                    title="{{#str}}resources, mod_smartvideo{{/str}}">
                                <i class="fa fa-paperclip" aria-hidden="true"></i>
                                <span class="badge bg-secondary smartvideo-resource-count-badge rounded-pill ms-1" style="font-size: 0.65rem;">{{resourcecount}}</span>
                            </button>
                        </li>
                    </ul>
                </div>

                {{! Sidebar Content Body }}
                <div class="smartvideo-sidebar-content tab-content flex-grow-1 overflow-auto p-2">
                    {{! PANEL 1: CHAPTERS }}
                    <div class="tab-pane fade show active smartvideo-panel-chapters" id="panelChapters" role="tabpanel">
                        <div class="p-1 mb-2">
                            <input type="text"
                                   class="form-control form-control-sm bg-dark text-white border-secondary smartvideo-search-chapters"
                                   placeholder="Search chapters...">
                        </div>
                        <div class="list-group list-group-flush smartvideo-chapters-list">
                            {{#chapters}}
                            <button type="button"
                                    class="list-group-item list-group-item-action bg-transparent text-white border-secondary border-opacity-25 d-flex align-items-center justify-content-between py-2 px-2 smartvideo-chapter-item"
                                    data-chapterid="{{id}}"
                                    data-timecode="{{timecode}}">
                                <div class="d-flex align-items-center gap-2 overflow-hidden me-2">
                                    <span class="badge bg-secondary bg-opacity-50 text-white font-monospace">{{timeformatted}}</span>
                                    <span class="smartvideo-chapter-title text-truncate">{{title}}</span>
                                </div>
                                <i class="fa fa-play fa-xs text-info smartvideo-chapter-playing-icon d-none" aria-hidden="true"></i>
                            </button>
                            {{/chapters}}
                            {{^haschapters}}
                            <div class="text-center py-4 text-white-50 small">
                                <i class="fa fa-list-ol fa-2x mb-2 opacity-50" aria-hidden="true"></i>
                                <div>{{#str}}nochapters, mod_smartvideo{{/str}}</div>
                            </div>
                            {{/haschapters}}
                        </div>
                    </div>

                    {{! PANEL 2: STUDENT TIMESTAMPED NOTES }}
                    <div class="tab-pane fade smartvideo-panel-notes" id="panelNotes" role="tabpanel">
                        {{! New Note Box }}
                        <div class="card bg-black bg-opacity-40 border-secondary border-opacity-25 mb-3 p-2">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <button type="button" class="btn btn-xs btn-outline-info py-0 px-2 font-monospace" id="svNoteCurrentTimeBtn" title="Use current playback time">
                                    <i class="fa fa-clock me-1"></i><span id="svNoteTimeDisplay">00:00</span>
                                </button>
                                <span class="small text-white-50">Click time to stamp</span>
                            </div>
                            <textarea id="svNoteInput" class="form-control form-control-sm bg-dark text-white border-secondary mb-2" rows="2" placeholder="{{#str}}noteprompt, mod_smartvideo{{/str}}"></textarea>
                            <div class="d-flex justify-content-end">
                                <button type="button" class="btn btn-sm btn-primary" id="svSaveNoteBtn">
                                    <i class="fa fa-plus me-1"></i>{{#str}}addnote, mod_smartvideo{{/str}}
                                </button>
                            </div>
                        </div>

                        {{! Notes List }}
                        <div class="d-flex justify-content-between align-items-center px-1 mb-2">
                            <span class="small fw-semibold text-white-50">{{#str}}studentnotes, mod_smartvideo{{/str}}</span>
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-link text-white-50 p-0 text-decoration-none small me-2" id="svExportNotesBtn" title="{{#str}}exportnotes, mod_smartvideo{{/str}}">
                                    <i class="fa fa-download me-1"></i>TXT
                                </button>
                                <button type="button" class="btn btn-link text-white-50 p-0 text-decoration-none small" id="svPrintNotesBtn" title="{{#str}}printnotes, mod_smartvideo{{/str}}">
                                    <i class="fa fa-print me-1"></i>Print
                                </button>
                            </div>
                        </div>

                        <div id="svNotesList" class="d-flex flex-column gap-2">
                            {{#notes}}
                            <div class="card bg-black bg-opacity-30 border-secondary border-opacity-25 p-2 smartvideo-note-card" data-noteid="{{id}}" data-timecode="{{timecode}}">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <button type="button" class="btn btn-xs btn-outline-primary py-0 px-1 font-monospace btn-note-seek" data-timecode="{{timecode}}">
                                        <i class="fa fa-play fa-xs me-1"></i>{{timeformatted}}
                                    </button>
                                    <button type="button" class="btn btn-link text-danger p-0 btn-note-delete" title="Delete note">
                                        <i class="fa fa-trash fa-xs"></i>
                                    </button>
                                </div>
                                <div class="small text-white note-content-text">{{content}}</div>
                            </div>
                            {{/notes}}
                            {{^hasnotes}}
                            <div class="text-center py-4 text-white-50 small sv-no-notes-placeholder">
                                <i class="fa fa-pencil fa-2x mb-2 opacity-50" aria-hidden="true"></i>
                                <div>{{#str}}nonotes, mod_smartvideo{{/str}}</div>
                            </div>
                            {{/hasnotes}}
                        </div>
                    </div>

                    {{! PANEL 3: CLINICAL & SCIENTIFIC CALCULATOR }}
                    <div class="tab-pane fade smartvideo-panel-calc" id="panelCalc" role="tabpanel">
                        <div class="d-flex gap-1 mb-2">
                            <button type="button" class="btn btn-sm btn-outline-primary flex-fill active" id="calcModeStandardBtn">Standard / Sci</button>
                            <button type="button" class="btn btn-sm btn-outline-info flex-fill" id="calcModeClinicalBtn">Clinical Presets</button>
                        </div>

                        {{! Standard / Scientific Calculator View }}
                        <div id="calcStandardView">
                            <div class="bg-black p-2 rounded border border-secondary border-opacity-50 mb-2">
                                <div class="text-white-50 small text-end font-monospace" id="calcFormula" style="min-height: 18px;"></div>
                                <input type="text" id="calcDisplay" class="form-control form-control-lg bg-transparent text-white text-end border-0 font-monospace p-0 fw-bold" value="0" readonly>
                            </div>
                            <div class="smartvideo-calc-grid">
                                <button type="button" class="btn btn-dark calc-key" data-key="C">C</button>
                                <button type="button" class="btn btn-dark calc-key" data-key="(">(</button>
                                <button type="button" class="btn btn-dark calc-key" data-key=")">)</button>
                                <button type="button" class="btn btn-dark calc-key text-warning" data-key="BACK">⌫</button>

                                <button type="button" class="btn btn-dark calc-key text-info" data-key="sqrt">√</button>
                                <button type="button" class="btn btn-dark calc-key text-info" data-key="sq">x²</button>
                                <button type="button" class="btn btn-dark calc-key text-info" data-key="%">%</button>
                                <button type="button" class="btn btn-secondary calc-key" data-key="/">÷</button>

                                <button type="button" class="btn btn-dark calc-key" data-key="7">7</button>
                                <button type="button" class="btn btn-dark calc-key" data-key="8">8</button>
                                <button type="button" class="btn btn-dark calc-key" data-key="9">9</button>
                                <button type="button" class="btn btn-secondary calc-key" data-key="*">×</button>

                                <button type="button" class="btn btn-dark calc-key" data-key="4">4</button>
                                <button type="button" class="btn btn-dark calc-key" data-key="5">5</button>
                                <button type="button" class="btn btn-dark calc-key" data-key="6">6</button>
                                <button type="button" class="btn btn-secondary calc-key" data-key="-">−</button>

                                <button type="button" class="btn btn-dark calc-key" data-key="1">1</button>
                                <button type="button" class="btn btn-dark calc-key" data-key="2">2</button>
                                <button type="button" class="btn btn-dark calc-key" data-key="3">3</button>
                                <button type="button" class="btn btn-secondary calc-key" data-key="+">+</button>

                                <button type="button" class="btn btn-dark calc-key" data-key="0" style="grid-column: span 2;">0</button>
                                <button type="button" class="btn btn-dark calc-key" data-key=".">.</button>
                                <button type="button" class="btn btn-primary calc-key" data-key="=">=</button>
                            </div>
                        </div>

                        {{! Clinical Presets View }}
                        <div id="calcClinicalView" class="d-none">
                            <div class="accordion accordion-flush" id="clinicalCalcAccordion">
                                {{! BMI Calculator }}
                                <div class="accordion-item bg-dark border-secondary border-opacity-25 text-white mb-2 rounded overflow-hidden">
                                    <h2 class="accordion-header" id="headingBmi">
                                        <button class="accordion-button bg-black bg-opacity-40 text-white collapsed py-2" type="button" data-bs-toggle="collapse" data-bs-target="#collapseBmi" aria-expanded="false" aria-controls="collapseBmi">
                                            <i class="fa fa-weight-scale text-primary me-2"></i>{{#str}}calc_bmi, mod_smartvideo{{/str}}
                                        </button>
                                    </h2>
                                    <div id="collapseBmi" class="accordion-collapse collapse" aria-labelledby="headingBmi">
                                        <div class="accordion-body p-2 bg-dark text-white">
                                            <div class="row g-2 mb-2">
                                                <div class="col-6">
                                                    <label class="small text-white-50">Weight (kg)</label>
                                                    <input type="number" id="bmiWeight" class="form-control form-control-sm bg-black text-white border-secondary" placeholder="70" step="0.5">
                                                </div>
                                                <div class="col-6">
                                                    <label class="small text-white-50">Height (cm)</label>
                                                    <input type="number" id="bmiHeight" class="form-control form-control-sm bg-black text-white border-secondary" placeholder="175" step="1">
                                                </div>
                                            </div>
                                            <button type="button" class="btn btn-sm btn-primary w-100 mb-2" id="btnCalcBmi">Calculate BMI</button>
                                            <div id="bmiResult" class="p-2 bg-black rounded text-center d-none">
                                                <span class="fs-5 fw-bold font-monospace" id="bmiValue">--</span>
                                                <div class="small fw-semibold mt-1" id="bmiCategory">--</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                {{! MAP Calculator }}
                                <div class="accordion-item bg-dark border-secondary border-opacity-25 text-white mb-2 rounded overflow-hidden">
                                    <h2 class="accordion-header" id="headingMap">
                                        <button class="accordion-button bg-black bg-opacity-40 text-white collapsed py-2" type="button" data-bs-toggle="collapse" data-bs-target="#collapseMap" aria-expanded="false" aria-controls="collapseMap">
                                            <i class="fa fa-heart-pulse text-danger me-2"></i>{{#str}}calc_map, mod_smartvideo{{/str}}
                                        </button>
                                    </h2>
                                    <div id="collapseMap" class="accordion-collapse collapse" aria-labelledby="headingMap">
                                        <div class="accordion-body p-2 bg-dark text-white">
                                            <div class="row g-2 mb-2">
                                                <div class="col-6">
                                                    <label class="small text-white-50">Systolic (mmHg)</label>
                                                    <input type="number" id="mapSystolic" class="form-control form-control-sm bg-black text-white border-secondary" placeholder="120">
                                                </div>
                                                <div class="col-6">
                                                    <label class="small text-white-50">Diastolic (mmHg)</label>
                                                    <input type="number" id="mapDiastolic" class="form-control form-control-sm bg-black text-white border-secondary" placeholder="80">
                                                </div>
                                            </div>
                                            <button type="button" class="btn btn-sm btn-primary w-100 mb-2" id="btnCalcMap">Calculate MAP</button>
                                            <div id="mapResult" class="p-2 bg-black rounded text-center d-none">
                                                <span class="fs-5 fw-bold font-monospace text-info" id="mapValue">--</span> <span class="small text-white-50">mmHg</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                {{! eGFR Calculator }}
                                <div class="accordion-item bg-dark border-secondary border-opacity-25 text-white rounded overflow-hidden">
                                    <h2 class="accordion-header" id="headingEgfr">
                                        <button class="accordion-button bg-black bg-opacity-40 text-white collapsed py-2" type="button" data-bs-toggle="collapse" data-bs-target="#collapseEgfr" aria-expanded="false" aria-controls="collapseEgfr">
                                            <i class="fa fa-flask text-warning me-2"></i>{{#str}}calc_egfr, mod_smartvideo{{/str}}
                                        </button>
                                    </h2>
                                    <div id="collapseEgfr" class="accordion-collapse collapse" aria-labelledby="headingEgfr">
                                        <div class="accordion-body p-2 bg-dark text-white">
                                            <div class="row g-2 mb-2">
                                                <div class="col-4">
                                                    <label class="small text-white-50">Creatinine (mg/dL)</label>
                                                    <input type="number" id="egfrCreatinine" class="form-control form-control-sm bg-black text-white border-secondary" placeholder="1.0" step="0.1">
                                                </div>
                                                <div class="col-4">
                                                    <label class="small text-white-50">Age (years)</label>
                                                    <input type="number" id="egfrAge" class="form-control form-control-sm bg-black text-white border-secondary" placeholder="45">
                                                </div>
                                                <div class="col-4">
                                                    <label class="small text-white-50">Sex</label>
                                                    <select id="egfrSex" class="form-select form-select-sm bg-black text-white border-secondary">
                                                        <option value="male">Male</option>
                                                        <option value="female">Female</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <button type="button" class="btn btn-sm btn-primary w-100 mb-2" id="btnCalcEgfr">Calculate eGFR</button>
                                            <div id="egfrResult" class="p-2 bg-black rounded text-center d-none">
                                                <span class="fs-5 fw-bold font-monospace text-warning" id="egfrValue">--</span>
                                                <span class="small text-white-50">mL/min/1.73m²</span>
                                                <div class="small mt-1" id="egfrStage">--</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    {{! PANEL 4: STRUCTURED CASE / MEDICAL REPORT }}
                    <div class="tab-pane fade smartvideo-panel-report" id="panelReport" role="tabpanel">
                        <div class="d-flex justify-content-between align-items-center mb-2 pb-1 border-bottom border-secondary border-opacity-25">
                            <span class="badge {{#report.issubmitted}}bg-success{{/report.issubmitted}}{{^report.issubmitted}}bg-warning text-dark{{/report.issubmitted}}" id="reportStatusBadge">
                                {{#report.issubmitted}}Submitted{{/report.issubmitted}}{{^report.issubmitted}}Draft{{/report.issubmitted}}
                            </span>
                            <div class="d-flex align-items-center gap-1">
                                <span class="small text-white-50 me-1" id="reportSavedIndicator"></span>
                                <button type="button" class="btn btn-xs btn-outline-info py-0 px-2 font-monospace" id="btnCiteTime" title="{{#str}}citetime, mod_smartvideo{{/str}}">
                                    <i class="fa fa-quote-left me-1"></i>[<span id="citeTimeVal">00:00</span>]
                                </button>
                            </div>
                        </div>

                        <form id="smartVideoReportForm">
                            <div class="mb-2">
                                <label for="reportFindings" class="form-label small fw-semibold text-white-50 mb-1">
                                    {{#str}}findings, mod_smartvideo{{/str}}
                                </label>
                                <textarea id="reportFindings" class="form-control form-control-sm bg-dark text-white border-secondary report-input-field" rows="3" placeholder="{{#str}}findings_placeholder, mod_smartvideo{{/str}}">{{report.findings}}</textarea>
                            </div>

                            <div class="mb-2">
                                <label for="reportImpression" class="form-label small fw-semibold text-white-50 mb-1">
                                    {{#str}}impression, mod_smartvideo{{/str}}
                                </label>
                                <textarea id="reportImpression" class="form-control form-control-sm bg-dark text-white border-secondary report-input-field" rows="2" placeholder="{{#str}}impression_placeholder, mod_smartvideo{{/str}}">{{report.impression}}</textarea>
                            </div>

                            <div class="mb-2">
                                <label for="reportDiagnosis" class="form-label small fw-semibold text-white-50 mb-1">
                                    {{#str}}differential, mod_smartvideo{{/str}}
                                </label>
                                <textarea id="reportDiagnosis" class="form-control form-control-sm bg-dark text-white border-secondary report-input-field" rows="2" placeholder="{{#str}}differential_placeholder, mod_smartvideo{{/str}}">{{report.diagnosis}}</textarea>
                            </div>

                            <div class="mb-3">
                                <label for="reportRecommendations" class="form-label small fw-semibold text-white-50 mb-1">
                                    {{#str}}recommendations, mod_smartvideo{{/str}}
                                </label>
                                <textarea id="reportRecommendations" class="form-control form-control-sm bg-dark text-white border-secondary report-input-field" rows="2" placeholder="{{#str}}recommendations_placeholder, mod_smartvideo{{/str}}">{{report.recommendations}}</textarea>
                            </div>

                            <div class="d-flex justify-content-between gap-2">
                                <button type="button" class="btn btn-sm btn-outline-secondary text-white" id="btnSaveReportDraft">
                                    <i class="fa fa-save me-1"></i>{{#str}}savedraft, mod_smartvideo{{/str}}
                                </button>
                                <button type="button" class="btn btn-sm btn-success" id="btnSubmitReport">
                                    <i class="fa fa-paper-plane me-1"></i>{{#str}}submitreport, mod_smartvideo{{/str}}
                                </button>
                            </div>
                        </form>
                    </div>

                    {{! PANEL 5: INTERACTIVE SEARCHABLE TRANSCRIPT }}
                    <div class="tab-pane fade smartvideo-panel-transcript" id="panelTranscript" role="tabpanel">
                        <div class="p-1 mb-2">
                            <input type="text"
                                   id="svSearchTranscript"
                                   class="form-control form-control-sm bg-dark text-white border-secondary"
                                   placeholder="{{#str}}searchtranscript, mod_smartvideo{{/str}}">
                        </div>
                        <div id="svTranscriptList" class="d-flex flex-column gap-1 smartvideo-transcript-list" style="max-height: 480px; overflow-y: auto;">
                            {{#subtitlecues}}
                            <div class="smartvideo-transcript-cue p-2 rounded cursor-pointer d-flex gap-2 align-items-start"
                                 data-start="{{start}}"
                                 data-end="{{end}}"
                                 data-cueindex="{{index}}">
                                <span class="badge bg-secondary bg-opacity-75 text-white font-monospace sv-cue-time">{{startformatted}}</span>
                                <span class="sv-cue-text small text-white-50 flex-grow-1">{{{text}}}</span>
                            </div>
                            {{/subtitlecues}}
                            {{^hascues}}
                            <div class="text-center py-4 text-white-50 small">
                                <i class="fa fa-align-left fa-2x mb-2 opacity-50" aria-hidden="true"></i>
                                <div>{{#str}}notranscript, mod_smartvideo{{/str}}</div>
                            </div>
                            {{/hascues}}
                        </div>
                    </div>

                    {{! PANEL 6: LECTURE HANDOUTS & RESOURCES (SIDEBAR DOCK) }}
                    <div class="tab-pane fade smartvideo-panel-resources" id="panelResources" role="tabpanel">
                        <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                            <span class="small fw-semibold text-white-50">{{#str}}resources, mod_smartvideo{{/str}}</span>
                            <button type="button" class="btn btn-xs btn-link text-white-50 p-0 text-decoration-none small btn-scroll-to-below-resources" title="Scroll to below video">
                                <i class="fa fa-arrow-down me-1"></i>{{#str}}dock_below, mod_smartvideo{{/str}}
                            </button>
                        </div>
                        <div class="list-group list-group-flush smartvideo-resources-list">
                            {{#resources}}
                            <div class="list-group-item bg-transparent text-white border-secondary border-opacity-25 d-flex align-items-center justify-content-between py-2 px-1">
                                <div class="d-flex align-items-center gap-2 overflow-hidden me-2">
                                    <i class="fa {{icon}} fa-lg" aria-hidden="true"></i>
                                    <div class="overflow-hidden">
                                        <div class="small fw-semibold text-truncate text-white">{{filename}}</div>
                                        <div class="text-white-50" style="font-size: 0.75rem;">{{filesize}}</div>
                                    </div>
                                </div>
                                <a href="{{fileurl}}" download class="btn btn-sm btn-outline-light py-0 px-2" title="{{#str}}downloadfile, mod_smartvideo{{/str}}">
                                    <i class="fa fa-download" aria-hidden="true"></i>
                                </a>
                            </div>
                            {{/resources}}
                            {{^hasresources}}
                            <div class="text-center py-4 text-white-50 small">
                                <i class="fa fa-paperclip fa-2x mb-2 opacity-50" aria-hidden="true"></i>
                                <div>{{#str}}noresources, mod_smartvideo{{/str}}</div>
                            </div>
                            {{/hasresources}}
                        </div>
                    </div>

                    {{! PANEL 7: TIMESTAMPED Q&A DISCUSSIONS (SIDEBAR DOCK) }}
                    <div class="tab-pane fade smartvideo-panel-qa" id="panelQA" role="tabpanel">
                        <div class="d-flex justify-content-between align-items-center mb-2 px-1">
                            <span class="small fw-semibold text-white-50">{{#str}}discussions, mod_smartvideo{{/str}}</span>
                            <button type="button" class="btn btn-xs btn-link text-white-50 p-0 text-decoration-none small btn-scroll-to-below-qa" title="Scroll to below video">
                                <i class="fa fa-arrow-down me-1"></i>{{#str}}dock_below, mod_smartvideo{{/str}}
                            </button>
                        </div>

                        {{! Ask Question Box (Sidebar) }}
                        <div class="card bg-black bg-opacity-40 border-secondary border-opacity-25 mb-3 p-2">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <button type="button" class="btn btn-xs btn-outline-info py-0 px-2 font-monospace btn-sync-qa-time" title="Use current playback time">
                                    <i class="fa fa-clock me-1"></i><span class="sv-qa-time-display">00:00</span>
                                </button>
                                <div class="form-check form-switch m-0">
                                    <input class="form-check-input sv-qa-include-time" type="checkbox" role="switch" checked title="Tag with video timestamp">
                                    <label class="form-check-label small text-white-50">Timecode</label>
                                </div>
                            </div>
                            <textarea class="form-control form-control-sm bg-dark text-white border-secondary mb-2 sv-sidebar-qa-input" rows="2" placeholder="{{#str}}questionplaceholder, mod_smartvideo{{/str}}"></textarea>
                            <div class="d-flex justify-content-end">
                                <button type="button" class="btn btn-sm btn-primary btn-post-qa-sidebar">
                                    <i class="fa fa-paper-plane me-1"></i>{{#str}}postquestion, mod_smartvideo{{/str}}
                                </button>
                            </div>
                        </div>

                        {{! Discussions List (Sidebar) }}
                        <div class="d-flex flex-column gap-2 smartvideo-sidebar-qa-threads" style="max-height: 480px; overflow-y: auto;">
                            {{#discussions}}
                            <div class="card bg-black bg-opacity-30 border-secondary border-opacity-25 p-2 smartvideo-qa-thread" data-discussionid="{{id}}">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="sv-qa-avatar">{{{userpicture}}}</div>
                                        <span class="small fw-semibold text-white">{{userfullname}}</span>
                                        {{#hastimecode}}
                                        <button type="button" class="btn btn-xs btn-outline-info py-0 px-1 font-monospace btn-seek-qa" data-timecode="{{timecode}}">
                                            <i class="fa fa-play fa-xs me-1"></i>{{timeformatted}}
                                        </button>
                                        {{/hastimecode}}
                                    </div>
                                    {{#candelete}}
                                    <button type="button" class="btn btn-link text-danger p-0 btn-delete-discussion" data-discussionid="{{id}}" title="Delete">
                                        <i class="fa fa-trash fa-xs"></i>
                                    </button>
                                    {{/candelete}}
                                </div>
                                <div class="small text-white-50 mb-2 qa-content-text">{{content}}</div>

                                {{! Nested replies if any }}
                                {{#hasreplies}}
                                <div class="ps-3 border-start border-secondary border-opacity-50 ms-1 mb-2 d-flex flex-column gap-2">
                                    {{#replies}}
                                    <div class="card bg-dark bg-opacity-40 border-0 p-1 rounded" data-discussionid="{{id}}">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div class="d-flex align-items-center gap-1">
                                                <span class="small fw-semibold text-white">{{userfullname}}</span>
                                                <span class="text-white-50" style="font-size: 0.7rem;">{{timecreatedformatted}}</span>
                                            </div>
                                            {{#candelete}}
                                            <button type="button" class="btn btn-link text-danger p-0 btn-delete-discussion" data-discussionid="{{id}}" title="Delete">
                                                <i class="fa fa-trash fa-xs"></i>
                                            </button>
                                            {{/candelete}}
                                        </div>
                                        <div class="small text-white-50 qa-content-text">{{content}}</div>
                                    </div>
                                    {{/replies}}
                                </div>
                                {{/hasreplies}}

                                {{! Inline reply trigger & box }}
                                <div class="sv-qa-reply-box mt-1">
                                    <button type="button" class="btn btn-xs btn-link text-white-50 p-0 text-decoration-none btn-toggle-reply">
                                        <i class="fa fa-reply me-1"></i>{{#str}}reply, mod_smartvideo{{/str}}
                                    </button>
                                    <div class="sv-qa-reply-form d-none mt-2">
                                        <div class="input-group input-group-sm">
                                            <input type="text" class="form-control bg-dark text-white border-secondary sv-qa-reply-input" placeholder="{{#str}}replyplaceholder, mod_smartvideo{{/str}}">
                                            <button class="btn btn-primary btn-submit-reply" type="button" data-parentid="{{id}}">
                                                <i class="fa fa-paper-plane"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            {{/discussions}}
                            {{^hasdiscussions}}
                            <div class="text-center py-4 text-white-50 small sv-no-qa-placeholder">
                                <i class="fa fa-comments fa-2x mb-2 opacity-50" aria-hidden="true"></i>
                                <div>{{#str}}nodiscussions, mod_smartvideo{{/str}}</div>
                            </div>
                            {{/hasdiscussions}}
                        </div>
                    </div>
                </div>
            </aside>
        </div>
    </div>

    {{! ZONE 3: Below the Video Area (Dockable Tools & Watch Progress) }}
    <div class="smartvideo-below-zone mt-2">
        {{! Watch progress bar & completion indicator }}
        <div class="d-flex justify-content-between align-items-center px-1 py-1">
            <div class="small text-muted d-flex align-items-center gap-2">
                <span>
                    {{#hascompletionrule}}
                    {{#str}}watchprogress, mod_smartvideo, { "percent": {{percentcompleted}}, "min": {{completionminpercent}} }{{/str}}
                    {{/hascompletionrule}}
                    {{^hascompletionrule}}
                    {{#str}}watchprogress_no_min, mod_smartvideo, {{percentcompleted}}{{/str}}
                    {{/hascompletionrule}}
                </span>
                {{#canmanage}}
                <a href="{{resetattemptsurl}}" class="btn btn-sm btn-outline-secondary py-0 px-2" title="{{#str}}resetmyattempts_desc, mod_smartvideo{{/str}}">
                    <i class="fa fa-refresh me-1" aria-hidden="true"></i>{{#str}}resetmyattempts, mod_smartvideo{{/str}}
                </a>
                <a href="{{{managequestionsurl}}}" class="btn btn-sm btn-outline-primary py-0 px-2">
                    <i class="fa fa-sliders me-1" aria-hidden="true"></i>Timeline Studio
                </a>
                {{/canmanage}}
            </div>
            <div class="progress" style="width: 200px; height: 8px;">
                <div class="progress-bar bg-success"
                     role="progressbar"
                     style="width: {{percentcompleted}}%;"
                     aria-valuenow="{{percentcompleted}}"
                     aria-valuemin="0"
                     aria-valuemax="100">
                </div>
            </div>
        </div>

        {{! Zone 3 Multi-Tab Card: Handouts & Q&A Discussions }}
        <div class="card mt-3 shadow-sm border-0 bg-white" id="svBelowWorkstationCard">
            <div class="card-header bg-light border-0 py-2 d-flex justify-content-between align-items-center">
                <ul class="nav nav-tabs card-header-tabs" id="belowZoneTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active fw-semibold" id="below-discussions-tab" data-bs-toggle="tab" data-bs-target="#below-discussions" type="button" role="tab">
                            <i class="fa fa-comments me-2 text-primary"></i>{{#str}}discussions, mod_smartvideo{{/str}}
                            <span class="badge bg-primary rounded-pill ms-1 smartvideo-qa-count-badge">{{discussioncount}}</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-semibold" id="below-resources-tab" data-bs-toggle="tab" data-bs-target="#below-resources" type="button" role="tab">
                            <i class="fa fa-paperclip me-2 text-info"></i>{{#str}}resources, mod_smartvideo{{/str}}
                            <span class="badge bg-secondary rounded-pill ms-1 smartvideo-resource-count-badge">{{resourcecount}}</span>
                        </button>
                    </li>
                </ul>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary btn-dock-qa" title="{{#str}}dock_to_sidebar, mod_smartvideo{{/str}}">
                        <i class="fa fa-columns me-1"></i><span>{{#str}}dock_to_sidebar, mod_smartvideo{{/str}}</span>
                    </button>
                </div>
            </div>

            <div class="card-body p-3 tab-content" id="belowZoneTabContent">
                {{! TAB A: Below Discussions }}
                <div class="tab-pane fade show active" id="below-discussions" role="tabpanel">
                    <div class="card bg-light border-0 p-3 mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-semibold small text-muted">{{#str}}askquestion, mod_smartvideo{{/str}}</span>
                            <div class="d-flex align-items-center gap-2">
                                <button type="button" class="btn btn-xs btn-outline-info py-0 px-2 font-monospace btn-sync-qa-time" title="Use current playback time">
                                    <i class="fa fa-clock me-1"></i><span class="sv-qa-time-display">00:00</span>
                                </button>
                                <div class="form-check form-switch m-0">
                                    <input class="form-check-input sv-qa-include-time" type="checkbox" role="switch" checked title="Tag with video timestamp">
                                    <label class="form-check-label small text-muted">Timecode</label>
                                </div>
                            </div>
                        </div>
                        <textarea class="form-control mb-2 sv-below-qa-input" rows="2" placeholder="{{#str}}questionplaceholder, mod_smartvideo{{/str}}"></textarea>
                        <div class="d-flex justify-content-end">
                            <button type="button" class="btn btn-sm btn-primary btn-post-qa-below">
                                <i class="fa fa-paper-plane me-1"></i>{{#str}}postquestion, mod_smartvideo{{/str}}
                            </button>
                        </div>
                    </div>

                    <div class="smartvideo-below-qa-threads d-flex flex-column gap-3">
                        {{#discussions}}
                        <div class="card border p-3 smartvideo-qa-thread" data-discussionid="{{id}}">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <div class="sv-qa-avatar">{{{userpicture}}}</div>
                                    <div>
                                        <span class="fw-semibold text-dark">{{userfullname}}</span>
                                        <span class="text-muted small ms-2">{{timecreatedformatted}}</span>
                                    </div>
                                    {{#hastimecode}}
                                    <button type="button" class="btn btn-xs btn-outline-info py-0 px-2 font-monospace ms-2 btn-seek-qa" data-timecode="{{timecode}}">
                                        <i class="fa fa-play fa-xs me-1"></i>{{timeformatted}}
                                    </button>
                                    {{/hastimecode}}
                                </div>
                                {{#candelete}}
                                <button type="button" class="btn btn-link text-danger p-0 btn-delete-discussion" data-discussionid="{{id}}" title="Delete">
                                    <i class="fa fa-trash"></i>
                                </button>
                                {{/candelete}}
                            </div>
                            <div class="text-dark mb-2 qa-content-text">{{content}}</div>

                            {{#hasreplies}}
                            <div class="ps-3 border-start ms-2 my-2 d-flex flex-column gap-2">
                                {{#replies}}
                                <div class="bg-light p-2 rounded" data-discussionid="{{id}}">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center gap-1">
                                            <span class="fw-semibold small text-dark">{{userfullname}}</span>
                                            <span class="text-muted" style="font-size: 0.75rem;">{{timecreatedformatted}}</span>
                                        </div>
                                        {{#candelete}}
                                        <button type="button" class="btn btn-link text-danger p-0 btn-delete-discussion" data-discussionid="{{id}}" title="Delete">
                                            <i class="fa fa-trash fa-xs"></i>
                                        </button>
                                        {{/candelete}}
                                    </div>
                                    <div class="small text-secondary qa-content-text">{{content}}</div>
                                </div>
                                {{/replies}}
                            </div>
                            {{/hasreplies}}

                            <div class="sv-qa-reply-box mt-1">
                                <button type="button" class="btn btn-xs btn-link text-muted p-0 text-decoration-none btn-toggle-reply">
                                    <i class="fa fa-reply me-1"></i>{{#str}}reply, mod_smartvideo{{/str}}
                                </button>
                                <div class="sv-qa-reply-form d-none mt-2">
                                    <div class="input-group input-group-sm">
                                        <input type="text" class="form-control sv-qa-reply-input" placeholder="{{#str}}replyplaceholder, mod_smartvideo{{/str}}">
                                        <button class="btn btn-primary btn-submit-reply" type="button" data-parentid="{{id}}">
                                            <i class="fa fa-paper-plane"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        {{/discussions}}
                        {{^hasdiscussions}}
                        <div class="text-center py-5 text-muted sv-no-qa-placeholder">
                            <i class="fa fa-comments fa-3x mb-2 opacity-50" aria-hidden="true"></i>
                            <div>{{#str}}nodiscussions, mod_smartvideo{{/str}}</div>
                        </div>
                        {{/hasdiscussions}}
                    </div>
                </div>

                {{! TAB B: Below Resources }}
                <div class="tab-pane fade" id="below-resources" role="tabpanel">
                    <div class="row g-3">
                        {{#resources}}
                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100 border p-3 d-flex flex-row align-items-center justify-content-between">
                                <div class="d-flex align-items-center gap-3 overflow-hidden me-2">
                                    <i class="fa {{icon}} fa-2x" aria-hidden="true"></i>
                                    <div class="overflow-hidden">
                                        <div class="fw-semibold text-truncate text-dark">{{filename}}</div>
                                        <div class="text-muted small">{{filesize}}</div>
                                    </div>
                                </div>
                                <a href="{{fileurl}}" download class="btn btn-sm btn-outline-primary" title="{{#str}}downloadfile, mod_smartvideo{{/str}}">
                                    <i class="fa fa-download me-1"></i>Download
                                </a>
                            </div>
                        </div>
                        {{/resources}}
                        {{^hasresources}}
                        <div class="col-12 text-center py-5 text-muted">
                            <i class="fa fa-paperclip fa-3x mb-2 opacity-50" aria-hidden="true"></i>
                            <div>{{#str}}noresources, mod_smartvideo{{/str}}</div>
                        </div>
                        {{/hasresources}}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{{#js}}
require(['mod_smartvideo/player'], function(Player) {
    Player.init('smartVideoContainer');
});
{{/js}}
